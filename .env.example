# Database defaults to BOOKSHELF_DATA_DIR/bookshelf.sqlite.
# Set BOOKSHELF_DB_PATH only to select a different database explicitly.
BOOKSHELF_DATA_DIR=./data
# Java originals default to BOOKSHELF_DATA_DIR/legacy.
BOOKSHELF_LEGACY_OWNER_USERNAME=trstyq
REGISTRATION=false
BOOKSHELF_SESSION_HOURS=12
BOOKSHELF_REMEMBER_DAYS=30
BOOKSHELF_COOKIE_SECURE=auto
BOOKSHELF_AUTO_BACKUP=true
BOOKSHELF_LOG_LEVEL=info
ALADIN_TTB_KEY=
ALADIN_MIN_REQUEST_INTERVAL_MS=100
ALADIN_MAX_ATTEMPTS=3
ALADIN_INITIAL_BACKOFF_MS=2000
ALADIN_MAX_BACKOFF_MS=30000
NEXT_PUBLIC_APP_NAME=Bookshelf
