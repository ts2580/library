{
  "name": "bookshelf",
  "version": "3.2.1",
  "private": true,
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "sharp": true,
    "@tailwindcss/oxide": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 25647",
    "build": "next build",
    "start": "next start -p 25647",
    "worker": "node --conditions=react-server --import tsx worker/worker.ts",
    "worker:dev": "node --conditions=react-server --import tsx --watch worker/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:verify": "node --conditions=react-server --import tsx scripts/verify-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:docker": "node scripts/verify-docker.mjs",
    "test:cleanup:docker": "node scripts/verify-legacy-cleanup-docker.mjs",
    "test:e2e:server": "node --conditions=react-server --import tsx scripts/e2e-server.ts",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "verify:source": "npm run check:syntax && npm run check:structure && npm run typecheck && npm test"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "@tailwindcss/postcss": "4.1.14",
    "archiver": "7.0.1",
    "bcryptjs": "3.0.2",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.1.2",
    "drizzle-orm": "0.45.4",
    "entities": "4.5.0",
    "exceljs": "4.4.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "unzipper": "0.12.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/archiver": "6.0.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/unzipper": "0.10.11",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.30",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "esbuild": "0.28.2"
  },
  "description": "Bookshelf Next.js web and background worker with Drizzle and SQLite"
}
